# Dead Frequency - server-only Tinker configuration
#
# Copy this file to .env.local for local development. Never commit real values.
# These values are read only by the server-side /api/director route.
# Do not prefix either value with NEXT_PUBLIC_; that would expose it to browsers.

# Tinker API key. Sent only in the Authorization header of the server's
# outbound request. Leave blank to use the labelled scripted fallback.
TINKER_API_KEY=

# A real Tinker sampling checkpoint path, not a base-model identifier.
# Required form: tinker://<run-id>/sampler_weights/<checkpoint-name>
# Run IDs can contain colons, e.g.
#   tinker://0034d8c9-0a88-52a9-b2b7-bce7cb1e6fef:train:0/sampler_weights/000080
# Raw names such as meta-llama/Llama-3.1-8B are rejected.
# Preparing a checkpoint is future budget-gated work; see docs/TINKER.md.
TINKER_MODEL_PATH=
